{
  "id": "sea-battle",
  "contexts": ["household", "shared_space"],
  "name": "Sea Battle",
  "version": "1.0.0",
  "description": "Async turn-based naval grid game — challenge a family member, place your fleet, and fire away.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "games",
  "tags": ["games", "kids", "strategy", "turn-based"],
  "icon": "⚓",
  "storage": "db",
  "db_encryption": "off",
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
    "member_references": {
      "games": [
        {
          "column": "challenger_id",
          "on_removed": "keep"
        },
        {
          "column": "opponent_id",
          "on_removed": "keep"
        },
        {
          "column": "current_turn_id",
          "on_removed": "keep"
        },
        {
          "column": "winner_id",
          "on_removed": "keep"
        },
        {
          "column": "resigned_by_id",
          "on_removed": "keep"
        }
      ],
      "ships": {
        "column": "owner_id",
        "on_removed": "keep"
      },
      "shots": [
        {
          "column": "shooter_id",
          "on_removed": "keep"
        },
        {
          "column": "target_player_id",
          "on_removed": "keep"
        }
      ]
    },
  "nav": { "label": "Sea Battle" },
  "publishes": ["sea-battle.game-started", "sea-battle.move-fired", "game.completed"],
  "alert_on": ["sea-battle.game-started", "game.completed"],
  "row_policies": {
    "games": {
      "kind": "party_scoped",
      "member_columns": ["challenger_id", "opponent_id"],
      "self_column": "challenger_id",
      "endpoint_writes_only": true,
      "retain_days": {
        "default": 365,
        "timestamp_column": "updated_at",
        "override_key": "game_history",
        "dependent_tables": [
          { "table": "ships", "foreign_key": "game_id" },
          { "table": "shots", "foreign_key": "game_id" }
        ]
      }
    },
    "ships": {
      "kind": "party_scoped",
      "member_columns": ["owner_id"],
      "endpoint_writes_only": true
    },
    "shots": {
      "kind": "party_scoped",
      "member_columns": ["shooter_id", "target_player_id"],
      "endpoint_writes_only": true
    }
  }
}
